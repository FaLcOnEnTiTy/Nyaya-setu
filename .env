# Environment Configuration for Nyaya Setu
# Default local SQLite database (zero-setup local development)
DATABASE_URL="file:./dev.db"

# For production deployment (PostgreSQL on Neon / Supabase / Vercel Postgres):
# Change provider in prisma/schema.prisma to "postgresql" and set:
# DATABASE_URL="postgresql://user:password@host:5432/nyaya_setu?sslmode=require"

NEXTAUTH_SECRET="nyaya-setu-secure-judicial-token-key-2026"
NEXT_PUBLIC_APP_NAME="Nyaya Setu | न्याय सेतु"

# Optional Gemini API key for Grounded Case Assistant
# (Built-in judicial knowledge fallback operates seamlessly if key is omitted)
GEMINI_API_KEY=""
